# Database
DATABASE_URL=postgresql://leo:leo_password@db:5432/leo

# LLM API Keys (at least one required)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# LiteLLM
LITELLM_URL=http://litellm:4000

# ChromaDB
CHROMA_URL=http://chroma:8000

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small

# Default LLM Model (используется для генерации промптов и т.д.)
# Доступные: claude-sonnet-4-6, claude-opus-4-6, claude-sonnet-4-5, gemini-3.1-pro-preview, gemini-2.5-pro
DEFAULT_LLM_MODEL=claude-sonnet-4-6

# LangSmith (for tracing)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls-...
LANGCHAIN_PROJECT=leo-agents

# Agent defaults
AGENT_IMAGE=leo-agent-runtime:latest
GATEWAY_URL=http://leo-gateway:8080
DOCKER_NETWORK=leo_network


OPENROUTER_KEY=sk-or-v1-...

# Shared secret between LiteLLM callback and leo-gateway webhook
# Generate: openssl rand -hex 32
WEBHOOK_SECRET=

# API secret for service-to-service auth (leo frontend -> ai-master)
# Generate: openssl rand -hex 32
API_SECRET=

# LiteLLM UI credentials (change in production!)
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=
LITELLM_DB_PASSWORD=
